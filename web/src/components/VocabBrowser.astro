---
import type { VocabRow } from '../lib/vocab';

interface Props {
  rows: VocabRow[];
}

const { rows } = Astro.props;

const weekTags = [...new Set(rows.flatMap((r) => r.tags).filter((t) => /^week\d+$/.test(t)))].sort();
const weekLabel = (t: string) => `Нед. ${Number(t.replace('week', ''))}`;
const LEVELS = ['a1', 'a2', 'b1', 'b2'];
const levelTags = LEVELS.filter((l) => rows.some((r) => r.tags.includes(l)));
const hasExamples = rows.some((r) => r.example);
---

<div class="vocab">
  <div class="vocab-controls">
    <input type="search" id="vocab-search" placeholder="Поиск: кыргызча или русский…" autocomplete="off" />
    <div class="tag-filters" id="vocab-tags">
      <button class="tag-btn active" data-tag="">Все</button>
      {levelTags.map((t) => <button class="tag-btn" data-tag={t}>{t.toUpperCase()}</button>)}
      {weekTags.map((t) => <button class="tag-btn" data-tag={t}>{weekLabel(t)}</button>)}
    </div>
  </div>

  <p class="vocab-count" id="vocab-count"></p>

  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr><th>Кыргызча</th><th>Русский</th>{hasExamples && <th>Пример</th>}<th>Темы</th></tr>
      </thead>
      <tbody id="vocab-body">
        {rows.map((r) => (
          <tr data-kg={r.kg.toLowerCase()} data-ru={r.ru.toLowerCase()} data-tags={r.tags.join(' ')}>
            <td>{r.kg} <button class="say-btn" data-say={r.kg} title="Озвучить">🔊</button></td>
            <td>{r.ru}</td>
            {hasExamples && <td class="ex">{r.example ?? ''}</td>}
            <td>{r.tags.join(', ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  import { speak } from '../lib/tts';

  // Delegated pronunciation handler for ~2000 rows.
  document.getElementById('vocab-body')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.say-btn');
    if (!btn?.dataset.say) return;
    const original = btn.textContent;
    btn.textContent = '…';
    speak(btn.dataset.say)
      .catch(() => {})
      .finally(() => { btn.textContent = original; });
  });

  const search = document.getElementById('vocab-search') as HTMLInputElement | null;
  const tagWrap = document.getElementById('vocab-tags');
  const count = document.getElementById('vocab-count');
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#vocab-body tr'));
  let activeTag = '';

  function apply() {
    const q = (search?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const row of rows) {
      const matchText = !q || (row.dataset.kg ?? '').includes(q) || (row.dataset.ru ?? '').includes(q);
      const matchTag = !activeTag || (row.dataset.tags ?? '').split(' ').includes(activeTag);
      const show = matchText && matchTag;
      row.hidden = !show;
      if (show) shown++;
    }
    if (count) count.textContent = `Показано: ${shown} из ${rows.length}`;
  }

  search?.addEventListener('input', apply);
  tagWrap?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.tag-btn');
    if (!btn) return;
    activeTag = btn.dataset.tag ?? '';
    tagWrap.querySelectorAll('.tag-btn').forEach((b) => b.classList.toggle('active', b === btn));
    apply();
  });

  apply();
</script>
