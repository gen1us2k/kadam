---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('docs', 'grammar-cheatsheet');
if (!entry) throw new Error('docs/grammar-cheatsheet not found');
const { Content, headings } = await render(entry);
const title = headings[0]?.text ?? 'Грамматика';
---

<Base title={title} active="/grammar">
  <article class="prose wide">
    <Content />
  </article>
</Base>
