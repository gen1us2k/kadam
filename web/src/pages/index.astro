---
import Base from '../layouts/Base.astro';
import Journey from '../components/Journey.tsx';
import { getCollection } from 'astro:content';
import { loadVocab } from '../lib/vocab';
import { splitLessons } from '../lib/lessons';
import { buildJourney } from '../lib/journey';
import { marked } from 'marked';

function renderMd(md: string): string {
  const html = marked.parse(md) as string;
  // Let wide grammar tables scroll horizontally on narrow screens.
  return html
    .replace(/<table>/g, '<div class="table-scroll"><table>')
    .replace(/<\/table>/g, '</table></div>');
}

const deck = loadVocab();
const entries = (await getCollection('weeks')).sort((a, b) => a.id.localeCompare(b.id));
const weeks = entries.map((entry) => ({
  slug: entry.id.split('/')[0],
  lessons: splitLessons(entry.body ?? '').map((l) => ({ title: l.title, html: renderMd(l.markdown) })),
}));
const steps = buildJourney(weeks, deck);
---

<Base title="Кыргызча 80/20 — путь изучения" active="/">
  <section class="hero">
    <h1>Кыргызский с нуля</h1>
    <p>
      Пошаговый путь: грамматика по порядку, а между темами — тренировка слов и интервальное
      повторение. Открывайте шаг, проходите его, отмечайте пройденным. Прогресс сохраняется.
    </p>
  </section>

  <Journey steps={steps} deck={deck} client:load />
</Base>
