---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('docs', 'phrases');
if (!entry) throw new Error('docs/phrases not found');
const { Content, headings } = await render(entry);
const title = headings[0]?.text ?? 'Разговорник';
---

<Base title={title} active="/phrases">
  <article class="prose wide">
    <Content />
  </article>
</Base>
