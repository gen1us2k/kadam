---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Journey from '../components/Journey.tsx';
import { loadVocab } from '../lib/vocab';
import { buildJourney } from '../lib/journey';

const deck = loadVocab();
const entries = (await getCollection('weeks')).sort((a, b) => a.id.localeCompare(b.id));
const weeks = await Promise.all(
  entries.map(async (entry) => {
    const { headings } = await render(entry);
    return {
      slug: entry.id.split('/')[0],
      title: headings.find((h) => h.depth === 1)?.text ?? entry.id.split('/')[0],
      headings,
    };
  }),
);
const steps = buildJourney(weeks, deck);
---

<Base title="Путь изучения · Кыргызча 80/20" active="/journey">
  <section class="prose">
    <h1>Путь изучения</h1>
    <p>
      Один маршрут от нуля: грамматические темы по порядку, а между ними — тренировка слов и
      интервальное повторение. Отмечайте пройденные шаги, прогресс сохраняется в браузере.
    </p>
  </section>

  <Journey steps={steps} deck={deck} client:load />
</Base>
