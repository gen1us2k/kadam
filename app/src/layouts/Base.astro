---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Path of the current page for nav highlighting, e.g. "/grammar". */
  active?: string;
}

const { title, description = 'Кыргызский язык за 10–12 недель по принципу 80/20.', active = '' } = Astro.props;

// Journey is the single plan; the nav keeps only it, the daily session, and the two ad-hoc
// tools with standalone value (paste-any-text reader, dictionary browser). Survival phrases
// live as a journey station; pronunciation checks live inside the session.
const links = [
  { href: '/', label: 'Путь' },
  { href: '/study', label: 'Сессия' },
  { href: '/reader', label: 'Чтение' },
  { href: '/vocab', label: 'Словарь' },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav wrap">
        <a class="brand" href="/">Кыргызча 80/20</a>
        {links.map((l) => (
          <a href={l.href} class={active === l.href ? 'active' : ''}>{l.label}</a>
        ))}
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        Материалы — markdown в корне репозитория. Учись каждый день · Anki + носитель.
      </div>
    </footer>
  </body>
</html>
