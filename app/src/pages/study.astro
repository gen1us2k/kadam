---
import Base from '../layouts/Base.astro';
import StudySession from '../components/StudySession.tsx';
import StatsPanel from '../components/StatsPanel.tsx';
import { loadVocab } from '../lib/vocab';

const deck = loadVocab();
---

<Base title="Дневная сессия · Кыргызча 80/20" active="/study">
  <section class="prose">
    <h1>Дневная сессия</h1>
    <p>
      Смешанное повторение (FSRS): просроченные карточки со всех тем + новые, вперемешку.
      Новые слова показываются на узнавание, зрелые — на письмо, cloze, диктант на слух и
      произношение вслух. Новых тем меньше, чем больше накопилось повторений (чтобы не завалить
      себя); упорно забываемые слова («пиявки») откладываются для отдельного разбора. Ошиблись —
      слово вернётся через 10 минут. Дриллы и сборка предложений живут на своих станциях пути.
    </p>
  </section>

  <StatsPanel deck={deck} client:load />

  <StudySession deck={deck} client:load />
</Base>
