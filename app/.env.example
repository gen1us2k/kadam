# Backend configuration. Copy to `.env` — it is loaded by both server/main.ts
# (Node process.loadEnvFile) and scripts/fetch-models.sh. All keys are optional;
# the defaults below apply when unset.

# HTTP port for the unified server (serves the built site + /api). Default: 4321.
PORT=4321

# Where the ONNX weights live. Default: <app>/models.
# ASR: model.onnx, vocab.json, asr-meta.json    TTS: tts/model.onnx, tts/tokens.txt
# Set an ABSOLUTE path to keep the ~450 MB of weights outside the repo (a shared volume, etc.).
# MODELS_DIR=/absolute/path/to/models

# Built static site directory served by the server. Default: <app>/dist.
# STATIC_DIR=/absolute/path/to/dist

# --- Telegram bot (server/bot.ts, отдельный процесс: `npm run bot`) ---

# Токен от @BotFather. Без него бот не стартует. На сервере задаётся не здесь, а через
# /etc/kadam-bot.env — deploy.sh не копирует .env на дроплет.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Время ежедневной рассылки, HH:MM в локальной зоне процесса. Default: 09:00.
# Зона задаётся переменной TZ (в systemd-юните — Environment=TZ=Asia/Bishkek).
# TELEGRAM_SEND_AT=09:00

# Файл состояния: подписчики, offset, день последней рассылки. Default: <app>/data/bot-state.json.
# В продакшене — /var/lib/kadam/bot-state.json, вне дерева rsync (иначе деплой сотрёт подписчиков).
# TELEGRAM_STATE_FILE=/var/lib/kadam/bot-state.json
